# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: absolute path to yt-dlp.exe (Windows) or yt-dlp (macOS/Linux).
# If omitted, the app uses the bundled bin/yt-dlp script through Python.
# YTDLP_BIN="C:\\Tools\\yt-dlp.exe"

# Optional: Python executable used to run the bundled yt-dlp script.
# PYTHON="C:\\Users\\YourName\\AppData\\Local\\Programs\\Python\\Python312\\python.exe"

# Optional: directory containing ffmpeg/ffprobe, or the ffmpeg executable path.
# FFmpeg is required to merge separate video/audio streams and convert MP3.
# FFMPEG_LOCATION="C:\\Tools\\ffmpeg\\bin"

# TikTok requires curl-cffi for browser impersonation:
# Run: "<PYTHON path>" -m pip install -r bin/requirements.txt
# Optional: Netscape-format cookies exported from a browser account that can
# access the post. Keep this file private and outside source control.
# TIKTOK_COOKIES_FILE="C:\\private\\tiktok-cookies.txt"

# YouTube may require authenticated cookies when hosted server IPs trigger bot checks.
# For Railway, base64-encode a Netscape-format cookies.txt and set the result as
# YOUTUBE_COOKIES_B64. Alternatively, point YOUTUBE_COOKIES_FILE to a private file.
# Never commit or share exported cookies; they grant access to your account.
# YOUTUBE_COOKIES_FILE="C:\\private\\youtube-cookies.txt"
# YOUTUBE_COOKIES_B64="BASE64_ENCODED_NETSCAPE_COOKIES"
